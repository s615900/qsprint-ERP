# MongoDB Atlas connection string (create a dedicated cluster/project for this app)
MONGODB_URI=mongodb+srv://USER:PASSWORD@CLUSTER.mongodb.net/?retryWrites=true&w=majority
# Database name inside the cluster
MONGODB_DB=studio_qcms
# Secret used to sign the customer session cookie (any long random string)
SESSION_SECRET=change-me-to-a-long-random-string

# --- LINE (all optional; features switch on once filled) ---
# LINE Login channel (customer login / registration / binding)
LINE_LOGIN_CHANNEL_ID=
LINE_LOGIN_CHANNEL_SECRET=
# Messaging API channel of the @LINE official account (binding code + push notifications).
# Must be under the same LINE provider as the Login channel so the userId matches.
LINE_MESSAGING_CHANNEL_SECRET=
LINE_MESSAGING_ACCESS_TOKEN=
LINE_OA_ID=@your_oa_id
# Public site origin; LINE callback = APP_URL/api/auth/line/callback
APP_URL=http://localhost:3005

# Back-office admins who may sign in with LINE (comma-separated LINE userIds).
# Leave empty at first: sign in once on /admin-login, copy the LINE ID it shows, put it here.
# More admins can then be added from 設定 → 後台管理員 with invite links.
ADMIN_LINE_USER_IDS=

# Local development only: 1 = skip the back-office login while editing (ignored in production)
DISABLE_ADMIN_AUTH=
